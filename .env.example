# In Vercel unter "Environment Variables" eintragen (lokal: Datei .env anlegen)
VITE_SUPABASE_URL=https://DEIN-PROJEKT.supabase.co
# Der "Publishable key" (früher "anon public") aus Supabase
VITE_SUPABASE_ANON_KEY=dein-publishable-key
# Registrierung in der App anzeigen? Zunächst false lassen.
VITE_ALLOW_SIGNUP=false
